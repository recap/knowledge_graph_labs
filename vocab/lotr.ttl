@prefix lotr: <https://recap.github.io/lotr-vocab/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

lotr:Character a rdfs:Class ;
    rdfs:label "Character" .

lotr:Dwarf a rdfs:Class ;
    rdfs:subClassOf lotr:Character .

lotr:Elf a rdfs:Class ;
    rdfs:subClassOf lotr:Character .

lotr:Man a rdfs:Class ;
    rdfs:subClassOf lotr:Character .

lotr:Hobbit a rdfs:Class ;
    rdfs:subClassOf lotr:Character .

lotr:Orc a rdfs:Class ;
    rdfs:subClassOf lotr:Character .

lotr:Wizard a rdfs:Class ;
    rdfs:subClassOf lotr:Character .

lotr:Place a rdfs:Class .

lotr:name a rdf:Property .
lotr:hasTitle a rdf:Property .
lotr:hasInterest a rdf:Property .
lotr:livesIn a rdf:Property .
lotr:sonOf a rdf:Property .
