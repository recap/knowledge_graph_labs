@prefix lotr: <https://recap.github.io/knowledge_graph_labs/vocab/> .
@prefix schema: <https://schema.org/> .

lotr:gimli a lotr:Dwarf ;
    schema:name "Gimli" ;
    lotr:sonOf lotr:gloin ;
    lotr:hasTitle "Lord of the Glittering Caves" ;
    lotr:livesIn lotr:middle_earth ;
    lotr:hasInterest "Axes", "Mithril" .

lotr:gloin a lotr:Dwarf ;
    scehma:name "Glóin" .

lotr:middle_earth a lotr:Place ;
    schema:name "Middle-earth" .
